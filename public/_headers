/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 应用入口始终先校验 HTML，避免新发布的资源清单被旧入口长期引用。
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/research
  Cache-Control: no-cache

/leverage
  Cache-Control: no-cache

/methodology
  Cache-Control: no-cache

/stock-logos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# 季度文件名可在季度内被更正；保留较长缓存，但不承诺永久不可变。
/data/fund-stock-index-*.json
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/data/fund-holdings-*.json
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/data/leverage-dashboard.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/leverage-dashboard.manifest.json
  Cache-Control: no-cache

/seo/*
  Cache-Control: public, max-age=86400

/og-image.svg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
