{
  "name": "fund-stock-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "hotspots": "node scripts/build_ai_battle_hotspots.mjs",
    "seo": "npm run hotspots && node scripts/build_seo_pages.mjs",
    "verify-live-release": "node scripts/verify-live-release.mjs",
    "verify-stock-deeplinks": "node scripts/verify-stock-deeplinks.mjs",
    "build": "npm run seo && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  }
}
